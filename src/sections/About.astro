---
import SectionHeading from '../components/SectionHeading.astro';
import { t, isTodo } from '../i18n/utils';
import { allSkills, type Lang } from '../data/content';
import { projects } from '../data/projects';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang).about;

// Handle diambil dari URL GitHub di site.ts; baris disembunyikan bila belum diisi
const github = site.contact.github;
const handle = isTodo(github) ? '' : github.replace(/^https?:\/\/(www\.)?github\.com\//i, '').replace(/\/+$/, '');

// Angka dihitung otomatis dari data: jumlah proyek & jumlah item skill unik
const stats = [
  { value: projects.length, label: ui.statProjects },
  { value: new Set(allSkills.map((s) => s.label.trim().toLowerCase())).size, label: ui.statTools },
];
---

<section id="about" class="relative py-16 sm:py-24 lg:py-28" aria-labelledby="about-title" data-slide>
  <div class="container-x grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
    <div class="scrim lg:col-span-7">
      <SectionHeading id="about-title" eyebrow={ui.eyebrow} title={ui.title} tight scrim={false} />
      <div class="space-y-4 text-pretty text-base leading-relaxed text-muted sm:text-lg" data-reveal-group>
        {ui.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <aside class="lg:col-span-5" data-reveal>
      <div class="card card-glow" data-spotlight>
        <div class="card-inner p-6 sm:p-8">
          <span class="spotlight" aria-hidden="true"></span>
          <div class="relative">
            <!-- TODO (opsional): ganti monogram dengan foto profil via astro:assets <Image alt={ui.photoAlt} /> -->
            <div class="flex items-center gap-4">
              <span
                class="grid size-14 shrink-0 place-items-center rounded-xl border border-line-strong bg-surface-2 font-mono text-lg font-semibold text-accent"
                aria-hidden="true">{site.initials}</span
              >
              <div class="min-w-0">
                <p class="font-medium text-fg">{site.name}</p>
                {handle && <p class="truncate font-mono text-xs text-subtle">@{handle}</p>}
              </div>
            </div>

            <div class="hairline my-6"></div>

            <dl class="space-y-4">
              {
                ui.facts.map((f) => (
                  <div class="grid gap-1 text-sm sm:grid-cols-[8.5rem_1fr] sm:gap-4">
                    <dt class="font-mono text-xs uppercase leading-5 tracking-wider text-subtle">{f.label}</dt>
                    <dd class="leading-5 text-fg">{f.value}</dd>
                  </div>
                ))
              }
            </dl>

            <div class="hairline my-6"></div>

            <dl class="grid grid-cols-2 gap-4">
              {
                stats.map((s) => (
                  <div>
                    <dt class="sr-only">{s.label}</dt>
                    <dd>
                      <span class="block text-3xl font-semibold tabular-nums tracking-tight text-fg sm:text-4xl" data-counter={s.value}>
                        {s.value}
                      </span>
                      <span class="mt-1 block font-mono text-xs text-subtle" aria-hidden="true">
                        {s.label}
                      </span>
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>
    </aside>
  </div>
</section>
