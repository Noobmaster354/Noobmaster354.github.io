---
import SectionHeading from '../components/SectionHeading.astro';
import SlideCurtain from '../components/SlideCurtain.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { t } from '../i18n/utils';
import { projects } from '../data/projects';
import type { Lang } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang).projects;
---

<section id="projects" class="relative py-24 sm:py-32" aria-labelledby="projects-title" data-slide>
  <SlideCurtain />
  <div class="container-x">
    <SectionHeading id="projects-title" eyebrow={ui.eyebrow} title={ui.title} intro={ui.intro} />
    <ul class="grid gap-5 sm:gap-6 md:grid-cols-2 md:pb-12" data-reveal-group>
      {
        projects.map((p, i) => (
          <li class:list={[i % 2 === 1 && 'md:translate-y-12']}>
            <ProjectCard project={p} lang={lang} index={i} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
