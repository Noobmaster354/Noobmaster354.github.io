---
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { t } from '../i18n/utils';
import { projects } from '../data/projects';
import type { Lang } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang).projects;
---

<section id="projects" class="relative py-16 sm:py-24 lg:py-28" aria-labelledby="projects-title" data-slide>
  <div class="container-x">
    <SectionHeading id="projects-title" eyebrow={ui.eyebrow} title={ui.title} intro={ui.intro} />
    <ul class="grid gap-5 sm:gap-6 md:grid-cols-2" data-reveal-group>
      {
        projects.map((p, i) => (
          <li>
            <ProjectCard project={p} lang={lang} index={i} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
