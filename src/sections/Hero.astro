---
import ArrowDown from '@lucide/astro/icons/arrow-down';
import Button from '../components/Button.astro';
import Typewriter from '../components/Typewriter.astro';
import { t } from '../i18n/utils';
import { site } from '../data/site';
import type { Lang } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const all = t(lang);
const ui = all.hero;
---

<!-- Plexus kini latar global (Layout.astro), jadi hero hanya berisi grid, glow, dan konten -->
<section
  id="top"
  class="hero relative isolate flex min-h-[100svh] items-center overflow-hidden pb-20 pt-28"
  aria-labelledby="hero-title"
  data-slide
  data-slide-label={all.nav.home}
>
  <div class="bg-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="hero-glow pointer-events-none absolute -z-10" aria-hidden="true" data-speed="0.25"></div>

  <div class="container-x relative z-[1]" data-hero>
    <div class="scrim max-w-2xl [--scrim-strength:55%]" data-speed="-0.08">
      <h1 id="hero-title">
        <span class="hero-item mb-4 block font-mono text-sm text-muted">{ui.greeting}</span>
        <span class="hero-line block text-[clamp(1.75rem,3.5vw,2.75rem)] font-medium leading-[1.1] tracking-[-0.025em] text-fg">
          {site.name}
        </span>
        <span class="hero-line mt-2 block font-mono text-[clamp(1rem,1.6vw,1.25rem)] font-normal leading-snug text-accent">
          {ui.role}
        </span>
      </h1>

      <p class="hero-line mt-6 max-w-xl text-pretty text-base leading-relaxed text-muted sm:text-lg">
        {ui.tagline}
      </p>

      <Typewriter prefix={ui.typingPrefix} words={ui.typingWords} class="hero-item mt-5 h-6 text-sm sm:text-base" />

      <div class="hero-item mt-9 flex flex-wrap items-center gap-3">
        <Button href="#projects" data-scroll-link="">{ui.ctaProjects}</Button>
        <Button href="#contact" variant="ghost" data-scroll-link="">{ui.ctaContact}</Button>
      </div>

      <ul class="hero-item mt-12 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-subtle">
        {
          ui.meta.map((m) => (
            <li class="flex items-center gap-2">
              <span class="size-1 rounded-full bg-accent" aria-hidden="true" />
              {m}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <a
    href="#about"
    class="hero-item group absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 font-mono text-[0.7rem] uppercase tracking-[0.25em] text-subtle hover:text-fg sm:flex"
    data-scroll-link
  >
    {ui.scroll}
    <ArrowDown size={14} class="scroll-cue" aria-hidden="true" />
  </a>
</section>

<style>
  .hero-glow {
    right: -10rem;
    top: 10%;
    width: 42rem;
    height: 42rem;
    border-radius: 9999px;
    background: radial-gradient(circle, var(--glow), transparent 65%);
    will-change: transform;
  }
  .scroll-cue {
    animation: cue 2s var(--ease-out-expo) infinite;
  }
  @keyframes cue {
    0% { transform: translateY(-3px); opacity: 0; }
    40% { opacity: 1; }
    100% { transform: translateY(6px); opacity: 0; }
  }
  @media (max-width: 767px) {
    .hero-glow {
      right: -18rem;
      top: -4rem;
    }
  }
</style>
