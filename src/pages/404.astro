---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { t, localizePath } from '../i18n/utils';

// Satu halaman 404 untuk GitHub Pages, menampilkan kedua bahasa.
const id = t('id').notFound;
const en = t('en').notFound;
---

<Layout lang="id" title={`${id.code} — ${t('id').meta.notFoundTitle}`} description={id.body} noindex>
  <section class="relative flex min-h-[80svh] items-center pt-24">
    <div class="bg-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="container-x">
      <p class="eyebrow" data-reveal>{id.code}</p>
      <h1 class="mt-5 text-[clamp(2rem,4.5vw,3rem)] font-semibold leading-[1.1] tracking-[-0.025em] text-fg">{id.title}</h1>
      <p class="mt-5 max-w-xl text-muted" data-reveal>{id.body}</p>
      <div class="mt-8 flex flex-wrap gap-3" data-reveal>
        <Button href={localizePath('/', 'id')}>{id.cta}</Button>
      </div>

      <div class="hairline my-12 max-w-xl"></div>

      <div lang="en">
        <h2 class="text-2xl font-semibold tracking-tight text-fg">{en.title}</h2>
        <p class="mt-3 max-w-xl text-muted">{en.body}</p>
        <div class="mt-6">
          <Button href={localizePath('/', 'en')} variant="ghost">{en.cta}</Button>
        </div>
      </div>
    </div>
  </section>
</Layout>
