---
import Sun from '@lucide/astro/icons/sun';
import Moon from '@lucide/astro/icons/moon';
import Menu from '@lucide/astro/icons/menu';
import X from '@lucide/astro/icons/x';
import { t, localizePath, alternatePath, otherLang } from '../i18n/utils';
import { site } from '../data/site';
import type { Lang } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const other = otherLang(lang);
const switchHref = alternatePath(Astro.url, other);

const links = [
  { href: localizePath('/#about', lang), label: ui.nav.about },
  { href: localizePath('/#projects', lang), label: ui.nav.projects },
  { href: localizePath('/#experience', lang), label: ui.nav.experience },
  { href: localizePath('/#skills', lang), label: ui.nav.skills },
  { href: localizePath('/#contact', lang), label: ui.nav.contact },
];
---

<header class="site-header fixed inset-x-0 top-0 z-50" data-header>
  <div class="header-bg absolute inset-0 -z-10" aria-hidden="true"></div>
  <nav class="container-x flex h-16 items-center justify-between gap-4" aria-label={ui.a11y.mainNav}>
    <a href={localizePath('/', lang)} class="group flex items-center gap-2.5">
      <span
        class="grid size-9 place-items-center rounded-lg border border-line-strong font-mono text-xs font-semibold text-accent transition-colors group-hover:border-accent"
        aria-hidden="true">{site.initials}</span
      >
      <span class="hidden font-mono text-sm text-muted transition-colors group-hover:text-fg sm:inline">
        {site.nickname}<span class="text-accent" aria-hidden="true">.</span>
      </span>
      <span class="sr-only">— {site.name}, {ui.nav.home}</span>
    </a>

    <ul class="hidden items-center gap-7 text-sm text-muted md:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="link-u transition-colors hover:text-fg">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={switchHref}
        hreflang={t(other).meta.htmlLang}
        lang={t(other).meta.htmlLang}
        class="icon-btn w-auto px-3 font-mono text-xs"
        data-lang-switch
        >{ui.a11y.langSwitchShort}<span class="sr-only"> — {ui.a11y.langSwitch}</span></a
      >
      <button type="button" class="icon-btn" aria-label={ui.a11y.themeToggle} data-theme-toggle>
        <Sun class="theme-icon-sun" size={17} aria-hidden="true" />
        <Moon class="theme-icon-moon" size={17} aria-hidden="true" />
      </button>
      <button
        type="button"
        class="icon-btn md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={ui.a11y.openMenu}
        data-label-open={ui.a11y.openMenu}
        data-label-close={ui.a11y.closeMenu}
        data-menu-toggle
      >
        <Menu class="menu-icon-open" size={18} aria-hidden="true" />
        <X class="menu-icon-close" size={18} aria-hidden="true" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="mobile-menu md:hidden" data-menu hidden>
    <ul class="container-x flex flex-col gap-1 pb-6 pt-2">
      {
        links.map((l, i) => (
          <li style={`--i:${i}`}>
            <a href={l.href} class="flex items-center justify-between border-b border-line py-3.5 text-lg text-fg" data-menu-link>
              {l.label}
              <span class="font-mono text-xs text-subtle">0{i + 1}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .header-bg {
    background: color-mix(in oklab, var(--bg) 72%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid transparent;
    opacity: 0;
    transition: opacity 0.35s ease, border-color 0.35s ease;
  }
  :global([data-scrolled]) .header-bg,
  :global(.menu-open) .header-bg {
    opacity: 1;
    border-color: var(--line);
  }
  :global([data-theme='dark']) .theme-icon-sun,
  :global([data-theme='light']) .theme-icon-moon {
    display: none;
  }
  .menu-icon-close {
    display: none;
  }
  [aria-expanded='true'] .menu-icon-open {
    display: none;
  }
  [aria-expanded='true'] .menu-icon-close {
    display: block;
  }
  .mobile-menu {
    background: color-mix(in oklab, var(--bg) 92%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .mobile-menu li {
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.35s ease calc(var(--i) * 40ms),
      transform 0.45s var(--ease-out-expo) calc(var(--i) * 40ms);
  }
  .mobile-menu.is-open li {
    opacity: 1;
    transform: none;
  }
</style>
