---
import ArrowUp from '@lucide/astro/icons/arrow-up';
import { t } from '../i18n/utils';
import type { Lang } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const year = new Date().getFullYear();
---

<footer class="relative z-[2] mt-24 border-t border-line">
  <div class="container-x flex flex-col items-start justify-between gap-4 py-8 text-sm text-subtle sm:flex-row sm:items-center">
    <p class="font-mono text-xs">© {year} {ui.footer.rights}. {ui.footer.built}</p>
    <a href="#main" class="icon-btn" aria-label={ui.a11y.backToTop} data-scroll-top>
      <ArrowUp size={16} aria-hidden="true" />
    </a>
  </div>
</footer>
