---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import ProjectCover from './ProjectCover.astro';
import { t, localizePath, isTodo } from '../i18n/utils';
import type { Lang } from '../data/content';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  lang: Lang;
  index: number;
}
const { project: p, lang, index } = Astro.props;
const ui = t(lang).projects;
const href = localizePath(`/projects/${p.slug}/`, lang);
---

<article class="card card-glow group h-full" data-spotlight>
  <div class="card-inner flex flex-col">
    <span class="spotlight" aria-hidden="true"></span>
    <div class="relative aspect-[16/10] overflow-hidden border-b border-line">
      <ProjectCover type={p.cover} />
      <span class="absolute left-4 top-4 chip bg-surface/80 backdrop-blur" aria-hidden="true">
        {String(index + 1).padStart(2, '0')}
      </span>
    </div>
    <div class="flex flex-1 flex-col p-6 sm:p-7">
      <p class="font-mono text-xs uppercase tracking-wider text-accent">{p.type[lang]}</p>
      <h3 class="mt-3 text-xl font-semibold tracking-tight text-fg sm:text-2xl">
        <a href={href} class="after:absolute after:inset-0 after:content-['']">
          {p.title[lang]}
        </a>
      </h3>
      <p class="mt-3 text-pretty text-sm leading-relaxed text-muted">{p.summary[lang]}</p>
      <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-6">
        <ul class="flex flex-wrap gap-2">
          {p.tools.filter((x) => !isTodo(x)).map((tool) => <li class="chip">{tool}</li>)}
        </ul>
        <span class="inline-flex items-center gap-1.5 text-sm font-medium text-fg" aria-hidden="true">
          {ui.viewCase}
          <ArrowUpRight size={16} class="transition-transform duration-500 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
        </span>
      </div>
    </div>
  </div>
</article>
