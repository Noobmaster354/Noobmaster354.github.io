---
/**
 * Ikon brand/tool. Sumber: Simple Icons (CC0) — dirender jadi SVG inline saat build (0 KB JS).
 * Ikon yang tidak tersedia di Simple Icons (LinkedIn, Tableau, Excel) memakai
 * glyph sederhana buatan sendiri di bawah.
 */
import {
  siGithub,
  siGooglesheets,
  siJupyter,
  siLooker,
  siMysql,
  siNumpy,
  siPandas,
  siPython,
  siScikitlearn,
  siTensorflow,
  siWhatsapp,
} from 'simple-icons';

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 18, class: cls = '' } = Astro.props;

const simple: Record<string, { path: string }> = {
  github: siGithub,
  googlesheets: siGooglesheets,
  jupyter: siJupyter,
  looker: siLooker,
  mysql: siMysql,
  numpy: siNumpy,
  pandas: siPandas,
  python: siPython,
  scikitlearn: siScikitlearn,
  tensorflow: siTensorflow,
  whatsapp: siWhatsapp,
};

// Glyph generik buatan sendiri (bukan logo resmi)
const custom: Record<string, string> = {
  linkedin:
    'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75Zm6.5 0h3.8v1.55h.06c.53-1 1.82-1.8 3.39-1.8 3.62 0 4.25 2.2 4.25 5.07V21h-4v-5.5c0-1.3-.03-2.98-1.82-2.98-1.82 0-2.1 1.42-2.1 2.89V21H9.5V9.75Z',
  tableau:
    'M11.2 2h1.6v3.2H16v1.6h-3.2V10h-1.6V6.8H8V5.2h3.2V2Zm0 12h1.6v3.2H16v1.6h-3.2V22h-1.6v-3.2H8v-1.6h3.2V14ZM5.2 8h1.6v3.2H10v1.6H6.8V16H5.2v-3.2H2v-1.6h3.2V8Zm12 0h1.6v3.2H22v1.6h-3.2V16h-1.6v-3.2H14v-1.6h3.2V8Z',
  excel:
    'M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm4.2 4 2.7 5-2.7 5h2.2l1.6-3.2 1.6 3.2h2.2l-2.7-5 2.7-5h-2.2L12 10.2 10.4 7H8.2Z',
};

const d = simple[name]?.path ?? custom[name];
---

{
  d && (
    <svg
      class:list={['shrink-0', cls]}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d={d} />
    </svg>
  )
}
