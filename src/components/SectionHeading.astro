---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  id: string;
  as?: 'h1' | 'h2';
  /** Jarak bawah rapat (judul langsung disusul paragraf, mis. bagian Tentang) */
  tight?: boolean;
  /** Alas pembaca di belakang teks (matikan bila induknya sudah memakai .scrim) */
  scrim?: boolean;
}
const { eyebrow, title, intro, id, as: Tag = 'h2', tight = false, scrim = true } = Astro.props;
---

<header class:list={['max-w-2xl', { scrim }, tight ? 'mb-5 sm:mb-6' : 'mb-10 sm:mb-14']}>
  <p class="eyebrow mb-4" data-reveal>{eyebrow}</p>
  <Tag id={id} class="section-title text-balance font-semibold text-fg" data-split>
    {title}
  </Tag>
  {intro && <p class="mt-4 max-w-xl text-pretty leading-relaxed text-muted sm:text-lg" data-reveal>{intro}</p>}
</header>
